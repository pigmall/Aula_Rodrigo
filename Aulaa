fun main() {

    // ===============================
    // Olá, Mundo!
    // ===============================
    println("Olá, Mundo!")
    println("Bem-vindo ao Kotlin!")

    // ===============================
    // Conhecendo o Utilizador
    // ===============================
    print("Informe seu nome: ")
    val nome = readLine() ?: ""

    print("Informe sua idade: ")
    val idade = readLine()?.toIntOrNull() ?: 0

    println("Olá, $nome! Você tem $idade anos.")

    // ===============================
    // Classificador de Idade (IF)
    // ===============================
    if (idade <= 12) {
        println("Você é uma criança.")
    } else if (idade <= 18) {
        println("Você é um adolescente.")
    } else {
        println("Você é um adulto.")
    }


    // ===============================
    // Função Classificadora
    // ===============================
    val resultadoClassificacao = classificarIdade(idade)
    println("Função classificarIdade: $resultadoClassificacao")

    // ===============================
    // Recomendador de Filmes (WHEN)
    // ===============================
    val recomendacao = recomendarFilmes(idade)
    println("Recomendação: $recomendacao")
}


// ===================================
// classificarIdade
// (Desafio 4)
// ===================================
fun classificarIdade(idade: Int): String {
    return if (idade <= 12) {
        "Você é uma criança."
    } else if (idade <= 18) {
        "Você é um adolescente."
    } else {
        "Você é um adulto."
    }
}


// ===================================
//  recomendarFilmes
// (Desafio 5)
// ===================================
fun recomendarFilmes(idade: Int): String {
    return when (idade) {
        in 0..12 -> "Recomendamos filmes infantis."
        in 13..18 -> "Recomendamos filmes adolescentes."
        else -> "Recomendamos filmes para adultos."
    }
}
