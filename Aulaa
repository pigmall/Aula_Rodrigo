fun main() {

    // Saída básica
    println("Olá, Mundo!")

    // Entrada de dados
    print("Digite seu nome: ")
    val nome = readLine() ?: ""

    print("Digite sua idade: ")
    val idade = readLine()?.toIntOrNull() ?: 0

    // Exibição
    println("Olá, $nome! Você tem $idade anos.")

    // Uso do if
    if (idade <= 12) {
        println("Classificação: Criança")
    } else if (idade <= 18) {
        println("Classificação: Adolescente")
    } else {
        println("Classificação: Adulto")
    }

    // Chamando função
    val tipo = classificarIdade(idade)
    println("Função classificarIdade: $tipo")

    // Chamando função com when
    val filmes = recomendarFilmes(idade)
    println("Recomendação de filmes: $filmes")
}

// Função com if
fun classificarIdade(idade: Int): String {
    return if (idade <= 12) "Criança"
    else if (idade <= 18) "Adolescente"
    else "Adulto"
}

// Função com when
fun recomendarFilmes(idade: Int): String {
    return when (idade) {
        in 0..12 -> "Infantis"
        in 13..18 -> "Adolescentes"
        else -> "Adultos"
    }
}
